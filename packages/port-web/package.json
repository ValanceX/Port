{
  "name": "@valancex/port-web",
  "version": "0.2.3",
  "description": "Web PORT: realizes MESH render trees as DOM, and reports interactions as handler identifiers and payloads.",
  "type": "module",
  "license": "MIT",
  "author": "Jack Miller <jackmiller0899@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ValanceX/Port.git",
    "directory": "packages/port-web"
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@valancex/mesh-runtime": "^0.6.0 || ^0.7.0 || ^0.8.0"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.0.0",
    "@valancex/mesh-compiler": "^0.6.0",
    "@valancex/mesh-runtime": "^0.6.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  }
}
